# Reference: https://postmarketos.org/uipkg
maintainer="Tinnci <23432137+Tinnci@users.noreply.github.com>"
pkgname=postmarketos-ui-ha-kiosk
pkgver=1
pkgrel=0
pkgdesc="(Wayland) Single-app Home Assistant dashboard kiosk (cage + Chromium)"
url="https://github.com/Tinnci/pmos-docker"
arch="noarch !armhf"
license="MIT"
depends="
	cage
	chromium
	curl
	elogind
	greetd
	postmarketos-base-ui
	wlr-randr
	"
_pmb_recommends="
	iio-sensor-proxy
	"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
subpackages="
	$pkgname-openrc
	$pkgname-systemd
	"
source="
	ha-kiosk.conf
	ha-kiosk-session
	greetd-config.toml
	greetd.confd
	systemd-greetd.conf
	"
options="!check pmb:drm pmb:default-systemd pmb:support-openrc pmb:support-systemd"

package() {
	install -Dm644 "$srcdir"/ha-kiosk.conf \
		"$pkgdir"/etc/ha-kiosk/ha-kiosk.conf
	install -Dm644 "$srcdir"/greetd-config.toml \
		"$pkgdir"/etc/ha-kiosk/greetd-config.toml
	install -Dm755 "$srcdir"/ha-kiosk-session \
		"$pkgdir"/usr/libexec/ha-kiosk-session
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="greetd-openrc"
	replaces="greetd-openrc"

	install -Dm644 "$srcdir"/greetd.confd \
		"$subpkgdir"/etc/conf.d/greetd
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends="greetd-systemd"

	install -Dm644 "$srcdir"/systemd-greetd.conf \
		"$subpkgdir"/usr/lib/systemd/system/greetd.service.d/override.conf
}

