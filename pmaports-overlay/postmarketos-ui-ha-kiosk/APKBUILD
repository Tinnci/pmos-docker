	ha-kiosk.conf
	ha-kiosk-session
	10-ha-kiosk.sh
	"
options="!check pmb:drm pmb:default-openrc pmb:support-openrc pmb:support-systemd"

package() {
	install -Dm644 "$srcdir"/ha-kiosk.conf \
		"$pkgdir"/etc/ha-kiosk/ha-kiosk.conf
	install -Dm644 "$srcdir"/10-ha-kiosk.sh \
		"$pkgdir"/etc/cage-ui/10-ha-kiosk.sh
	install -Dm755 "$srcdir"/ha-kiosk-session \
		"$pkgdir"/usr/libexec/ha-kiosk-session
}

